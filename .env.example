# PostgreSQL Connection URL (Neon / Supabase / Local)
# Production / Staging Neon Postgres:
# DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/discipline_db?schema=public"

# Application Settings
NEXT_PUBLIC_APP_NAME="Agent 47 — Disciplinary Management & Due Process System"
NEXT_PUBLIC_INSTITUTION_NAME="National Institute of Technology & Advanced Studies"

# Optional: Clerk Auth Keys (if deploying with Clerk SSO)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."

# Groq Cloud API for EDUguard AI Disciplinary Chatbot & Precedent Engine
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_FALLBACK_MODEL="groq/compound-mini"
